{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/engine/game.ts", "src/policies/*.ts"],
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.config.cjs"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "timeoutMS": 5000,
  "files": [
    "src/engine/**",
    "src/policies/**",
    "src/storage/**",
    "tests/unit/**",
    "jest.config.cjs",
    "package.json",
    "tsconfig.json",
    "src/config/**",
    "src/services/**"
  ],
  "tempDirName": ".stryker-tmp"
}
