{
  "expo": {
    "name": "Sort and Roll",
    "slug": "sort-and-roll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon-1024.png",
    "scheme": "sortandroll",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/app-icon-1024.png",
      "bundleIdentifier": "com.gpatatoukas.sort-and-roll"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111728",
        "foregroundImage": "./assets/branding/android-foreground.png",
        "monochromeImage": "./assets/branding/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gpatatoukas.sortandroll"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbf5ee",
          "image": "./assets/branding/splash-light.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111728",
            "image": "./assets/branding/splash-dark.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      "react-native-google-mobile-ads"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
