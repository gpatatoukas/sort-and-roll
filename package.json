    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:mutation": "stryker run",
    "test:e2e:web": "playwright test",
    "export:web": "expo export --platform web",
    "format": "prettier --write src/engine src/storage src/features src/services src/config src/app/index.tsx src/app/_layout.tsx tests e2e docs *.config.*",
